# Opsrid lokale Konfiguration. Keine echten Geheimnisse committen.

# Öffentliche Ziel-Domain ist opsrid.com. Betreiberangaben sind noch offen.
NEXT_PUBLIC_SITE_URL=https://opsrid.com
# Übergangsadresse aus der bestehenden Infrastruktur; vor Livegang verifizieren/ersetzen.
NEXT_PUBLIC_CONTACT_EMAIL=hallo@vierwochen.de
NEXT_PUBLIC_CONTACT_PHONE=

# Google Cloud / Vertex AI. In Cloud Run wird das Projekt aus der Laufzeit gesetzt.
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-3.5-flash-lite

# Optional: ohne Kalender-ID speichert die Anwendung eine Buchungsanfrage zur manuellen Bestätigung.
BOOKING_CALENDAR_ID=

# Optional: Admin-Auswertung und Mailversand. Werte nur über Secret Manager/Cloud-Build-Substitutionen setzen.
ADMIN_PASSWORD=
MAIL_SENDER=
CONTACT_EMAIL=
CLEANUP_TOKEN=

# Sichtbarkeit. SITE_LIVE=1 hebt noindex auf. SITE_PASSWORD schützt eine Vorschau.
SITE_LIVE=0
SITE_PASSWORD=
